# Copy to .env.local and fill in. Every value is public; the dev project's Supabase values are in
# ../app/config/dev.json (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The service's origin, which the server reads as it runs; its admin host is admin.localhost:3000.
KNOWNO_SERVICE_ORIGIN=http://localhost:3000
